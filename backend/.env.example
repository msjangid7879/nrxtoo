# NRXTOO Jewellery & Stones Suite - Backend Environment Variables

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=nrxtoo-super-secret-jwt-key-2026-change-in-production
JWT_EXPIRES_IN=7d

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nrxtoo_jewellery_db
DB_SSL=false
DB_POOL_MAX=20

# Uploads directory
UPLOAD_DIR=./uploads
